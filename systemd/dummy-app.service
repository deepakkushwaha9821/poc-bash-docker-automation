[Unit]
Description=Dummy App Service for Docker Deployment POC
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/app
ExecStart=/usr/bin/python3 /app/backend/server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8000

[Install]
WantedBy=multi-user.target
